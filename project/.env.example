# Servidor (NODE_ENV é definido pelos scripts: dev = development, start = production)
PORT=3000

# Banco MariaDB
DB_HOST=localhost
DB_PORT=3306
DB_NAME=deskhelp
DB_USER=deskhelp
DB_PASSWORD=

# Autenticação (gere com: openssl rand -hex 32)
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Permite que visitantes criem conta comum pela tela de cadastro (true/false)
ALLOW_SIGNUP=true

# Administrador inicial criado por "npm run db:migrate" (somente se ainda não existir)
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@deskhelp.local
ADMIN_PASSWORD=
